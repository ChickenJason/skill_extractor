{
  "schema_version": 1,
  "module": "second_layer_bidirectional_interaction",
  "pipeline_version": "bidirectional-interaction-context-v1",
  "protocol_version": "trf-exemplar-synchronous-v1",
  "base": {
    "concurrent_config": "config/second_layer.json",
    "accepted_pipeline_versions": ["second-layer-parallel-v1"],
    "expected_target_count": 326
  },
  "resources": {
    "instance_discriminator_config": "config/instance_discriminator.json",
    "trf_semantic_contract": "config/trf_reflection_semantics.json"
  },
  "provider": {
    "name": "aliyun-model-studio",
    "api_key": "${DASHSCOPE_API_KEY}",
    "base_url": "${DASHSCOPE_BASE_URL}"
  },
  "chat": {
    "model": "qwen3.7-plus-2026-05-26",
    "enable_thinking": false,
    "structured_output": true,
    "response_format_mode": "json_schema",
    "temperature": 0.0,
    "max_tokens": 4096,
    "timeout_seconds": 120,
    "max_retries": 5,
    "max_prompt_characters": 60000,
    "max_reason_characters": 240
  },
  "interaction": {
    "default_mode": "bidirectional",
    "max_rounds": 2,
    "candidate_count": 16,
    "max_repair_attempts": 2
  },
  "output": {
    "runs_root": "output/second_layer"
  }
}
