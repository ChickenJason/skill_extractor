{
  "schema_version": 1,
  "module": "self_annotator",
  "version": "qwen-inline-self-annotator-v6.0",
  "annotation_schema": "skill-inline-span-v1",
  "consensus_schema": "span-xmlc-majority-anchor-overlap-v2",
  "input": "data/raw/skill_sentences.json",
  "prompt": {
    "version": "skill-inline-annotation-v4.1",
    "template": "code/self_annotator/prompt_template/skill_annotation.txt"
  },
  "provider": {
    "name": "aliyun-model-studio",
    "api_key": "${DASHSCOPE_API_KEY}",
    "base_url": "${DASHSCOPE_BASE_URL}"
  },
  "model": {
    "name": "qwen3.7-plus-2026-05-26",
    "enable_thinking": false,
    "structured_output": true
  },
  "generation": {
    "samples": 5,
    "temperature": 0.7,
    "max_tokens": 1024,
    "timeout_seconds": 120,
    "max_retries": 5
  },
  "aggregation": {
    "min_valid_samples": 3,
    "min_has_skill_votes": 3,
    "min_no_skill_votes": 4,
    "min_exact_candidate_votes": 3,
    "min_exact_accept_votes": 3,
    "min_family_candidate_votes": 3,
    "hard_match_family_votes": 3,
    "hard_match": {
      "overlap_metric": "anchor_character_coverage",
      "length_unit": "word_units",
      "threshold_base": 0.45,
      "threshold_step": 0.05,
      "threshold_cap": 0.85,
      "comparison_epsilon": 1e-12
    }
  },
  "output": {
    "runs_root": "output/self_annotator"
  }
}
